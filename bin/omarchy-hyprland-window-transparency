#!/bin/bash

# omarchy:summary=Show or set how see-through windows are: opaque, transparent, or glassy
# omarchy:args=[opaque|transparent|glassy]
# omarchy:examples=omarchy hyprland window transparency | omarchy hyprland window transparency glassy

TOGGLES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr"

# Opaque and glassy are toggle files loaded after every theme, applied to the
# windows Omarchy makes transparent. Transparent, the default, removes both.
if (( $# == 0 )); then
  if [[ -f $TOGGLES_DIR/window-opaque.lua ]]; then
    echo "opaque"
  elif [[ -f $TOGGLES_DIR/window-glassy.lua ]]; then
    echo "glassy"
  else
    echo "transparent"
  fi
  exit 0
fi

case $1 in
  opaque) LABEL="Opaque windows" ;;
  transparent) LABEL="Transparent windows" ;;
  glassy) LABEL="Glassy windows" ;;
  *)
    echo "Usage: omarchy-hyprland-window-transparency [opaque|transparent|glassy]" >&2
    exit 1
    ;;
esac

rm -f "$TOGGLES_DIR/window-opaque.lua" "$TOGGLES_DIR/window-glassy.lua"
if [[ $1 != "transparent" ]]; then
  mkdir -p "$TOGGLES_DIR"
  cp "$OMARCHY_PATH/default/hypr/toggles/window-$1.lua" "$TOGGLES_DIR/window-$1.lua"
fi

hyprctl reload >/dev/null
omarchy-notification-send -g 󰂵 "$LABEL"
